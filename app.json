{
  "expo": {
    "name": "MIZAN",
    "slug": "mizan",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mizan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090E17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aeroooman.mizan",
      "buildNumber": "1.0.6",
      "infoPlist": {
        "NSCameraUsageDescription": "يحتاج التطبيق لإذن الكاميرا لمسح وقراءة الفواتير الضريبية وإيصالات الشراء.",
        "NSFaceIDUsageDescription": "يحتاج التطبيق لاستخدام بصمة الوجه لحماية بياناتك المالية وتأمين التطبيق."
      }
    },
    "android": {
      "package": "com.aeroooman.mizan",
      "versionCode": 23,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090E17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://aeroooman-svg.github.io/mizan/"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00E676"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withRemoveAudioForegroundServices"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://aeroooman-svg.github.io/mizan/"
      },
      "eas": {
        "projectId": "8d873738-3daa-480e-9ba1-11284a3642d9"
      }
    },
    "owner": "aeroman"
  }
}
